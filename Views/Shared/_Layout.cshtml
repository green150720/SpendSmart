
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SpendSmart</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="ss-navbar">
            <div class="ss-nav-container">
                <a class="ss-brand" asp-controller="Home" asp-action="Index">
                    <span class="ss-brand-icon">S</span>
                    <span>SpendSmart</span>
                </a>

                <div class="ss-nav-links">
                    <a asp-controller="Home" asp-action="Index">Home</a>
                    <a asp-controller="Home" asp-action="Expenses">Expenses</a>
                    <a asp-controller="Home" asp-action="CreateEditExpense">+ Add Expense</a>
                </div>

                <button type="button" id="themeToggle"
                        class="ss-theme-toggle"
                        aria-label="Switch colour theme">
                    🌙 Dark mode
                </button>
            </div>
        </nav>
    </header>

    <main class="ss-main">
        @RenderBody()
    </main>

    <footer class="ss-footer">
        <div class="container">
            <span>SpendSmart</span> · Manage your money with clarity.
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
            (() => {
                const root = document.documentElement;
                const toggle = document.getElementById("themeToggle");

                function applyTheme(theme) {
                    root.setAttribute("data-theme", theme);
                    toggle.textContent = theme === "dark"
                        ? "☀️ Light mode"
                        : "🌙 Dark mode";
                }

                let savedTheme = "light";

                try {
                    savedTheme = localStorage.getItem("spendsmart-theme") || "light";
                } catch {
                    // Continue with light mode if storage is unavailable.
                }

                applyTheme(savedTheme);

                toggle.addEventListener("click", () => {
                    const nextTheme =
                        root.getAttribute("data-theme") === "dark"
                            ? "light"
                            : "dark";

                    applyTheme(nextTheme);

                    try {
                        localStorage.setItem("spendsmart-theme", nextTheme);
                    } catch {
                        // The toggle still works for the current page.
                    }
                });
            })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
