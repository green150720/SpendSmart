@model SpendSmart.ViewModels.RegisterViewModel

<div class="auth-wrapper">
    <div class="auth-box">
        <h2 class="text-center mb-4">Register</h2>

        <form asp-action="Register" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="form-group mb-3">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" placeholder="Enter your email" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="Password"></label>
                <input asp-for="Password" class="form-control" placeholder="Create a password" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirm your password" />
            </div>

            <button type="submit" class="btn btn-primary w-100">Register</button>

            <div class="text-center mt-3">
                <span>Already have an account?</span>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-sm ms-2">Login</a>
            </div>
        </form>
    </div>
</div>