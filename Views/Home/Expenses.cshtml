@model List<SpendSmart.Models.Expense>

@{
    ViewData["Title"] = "Expenses";
}

<div class="text-center">
    <h1 class="display-4">Expenses</h1>
    <hr />

    <div class="stats-row">
        <div class="stat-card">
            <div class="stat-label">Total expenses</div>
            <div class="stat-value">₦@(((decimal)ViewBag.Expenses).ToString("N2"))</div>
        </div>

        <div class="stat-card">
            <div class="stat-label">This month's expenses</div>
            <div class="stat-value">₦@(((decimal)ViewBag.MonthlyExpenses).ToString("N2"))</div>
        </div>

        <div class="stat-card">
            <div class="stat-label">Total transactions</div>
            <div class="stat-value">@ViewBag.TotalTransactions</div>
        </div>
    </div>
</div>
<div class="table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Value</th>
                <th>Description</th>
                <th>Category</th>
                <th>Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var expense in Model)
            {
                <tr>
                    <td>@expense.Id</td>
                    <td>₦@expense.Value.ToString("N2")</td>
                    <td>@expense.Description</td>
                    <td>@expense.Category</td>
                    <td>@expense.Date?.ToString("dd MMM yyyy")</td>
                    <td>
                        <a asp-action="CreateEditExpense"
                           asp-route-id="@expense.Id"
                           class="btn btn-sm btn-primary">Edit</a>

                        <a asp-action="DeleteExpense"
                           asp-route-id="@expense.Id"
                           class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

    <a asp-action="CreateEditExpense"
       class="btn btn-success">Add New Expense</a>
